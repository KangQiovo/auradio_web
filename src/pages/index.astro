---
import Site from '../layouts/Site.astro';
import Arrow from '../components/Arrow.astro';
import HeroField from '../components/HeroField';
import AlbumRoom from '../components/AlbumRoom';
import ThemePreview from '../components/ThemePreview';
import ProviderExplorer from '../components/ProviderExplorer';
import {faqs} from '../lib/content.mjs';
import {route} from '../lib/urls';
---
<Site>
  <section class="hero wrap">
    <div class="hero-copy">
      <h1>听见。<br/><em>也看见。</em></h1>
      <p class="hero-description">为你手里的音乐，留一个舒服的位置。<br/>Auradio 是一个仍在打磨中的<br class="desktop-only"/> Android 音乐播放器。</p>
      <div class="hero-actions"><a class="button button-mint" href={route('experience/')}>打开体验室 <Arrow/></a><a class="text-link" href={route('progress/')}>看看当前进度 <Arrow diagonal/></a></div>
      <p class="hero-release">从聆听出发<span>Android · 正在打磨</span></p>
    </div>
    <HeroField client:load/>
    <div class="hero-bottom"><span>留给音乐，多一点空间。</span><a href="#everyday">向下了解 <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" aria-hidden="true"><path d="M10 3v14m-5-5 5 5 5-5"/></svg></a></div>
  </section>
  <div class="facts-rail"><div class="wrap"><span><b>Android</b>当前开发平台</span><span><b>MIUIX · Liquid · Material 3</b>三套客户端主题</span><span><b>16 种语言</b>客户端语言资源</span></div></div>
  <section id="everyday" class="light-section section-pad">
    <div class="wrap">
      <div class="section-intro" data-reveal><span class="section-number">01 / 日常聆听</span><h2>先把每天会用到的事，<br/>做好。</h2><p>找到喜欢的歌，整理自己的曲库。<br/>界面可以换一种样子，音乐始终在中间。</p></div>
      <div class="product-story">
        <div class="story-column">
          <nav class="chapter-nav" aria-label="功能章节"><a href="#library" data-chapter-link="library">本地曲库</a><a href="#themes" data-chapter-link="themes">界面主题</a><a href="#android" data-chapter-link="android">Android 主线</a></nav>
          <article id="library" data-chapter="library"><span class="story-index">01</span><h3>你的歌，<br/>按熟悉的方式找到。</h3><p>当前 Android 预发布围绕本地音乐展开：按歌曲、专辑和艺术家浏览，搜索想听的内容，整理播放队列。</p><p class="small-note">右侧是可搜索、可切换分类的网页示意。示例名称并非你的实际曲库。</p></article>
          <article id="themes" data-chapter="themes"><span class="story-index">02</span><h3>一套播放器，<br/>三种界面选择。</h3><p>MIUIX、Liquid 与 Material 3 是当前客户端支持的三套主题。官网把切换做成了一个小预览，你可以先感受不同表面与控件的关系。</p><p class="small-note">主题预览不是实机截图，不承诺与客户端逐像素一致。</p></article>
          <article id="android" data-chapter="android"><span class="story-index">03</span><h3>从 Android 开始，<br/>把细节一处处理顺。</h3><p>从 Android 开始，围绕本地聆听打磨操作与界面。已经做好的，留在体验里；尚未准备好的，不提前许诺。</p><a class="text-link dark-link" href={route('progress/')}>了解 Auradio <Arrow/></a></article>
        </div>
        <div class="sticky-preview"><ThemePreview client:visible/></div>
      </div>
    </div>
  </section>
  <section id="records" class="record-section section-pad wrap">
    <div class="record-section-heading" data-reveal><span class="section-number">02 / 精选聆听</span><h2>一首歌，<br/>一种颜色。</h2><p>从邓紫棋的三首作品开始。<br/>切换封面，看色彩自然地融进页面。</p></div>
    <AlbumRoom compact client:visible/>
    <div class="wide-link"><span>也想看看自己的音乐，是什么样子？</span><a class="text-link" href={route('experience/#local')}>进入本地声场 <Arrow/></a></div>
  </section>
  <section class="light-section section-pad">
    <div class="wrap"><div class="section-intro" data-reveal><span class="section-number">03 / 音乐平台入口</span><h2>本地是本地，<br/>平台是平台。</h2><p>客户端提供官方网页或应用入口。<br/>网页会话确认，不等于原生曲库连接。</p></div><ProviderExplorer client:visible/></div>
  </section>
  <section class="release-teaser section-pad wrap" data-reveal>
    <div><span class="section-number">04 / 关于进展</span><h2>慢一点，<br/>把聆听做好。</h2><p>Android 预发布正在打磨。<br/>更多消息，准备好后再与你分享。</p><a class="text-link" href={route('progress/')}>了解现在的 Auradio <Arrow/></a></div>
    <a class="release-cover anticipation-cover" href={route('progress/')}><div><span>A WORK IN PROGRESS</span><Arrow diagonal/></div><strong>留一点<span>期待。</span></strong><div><span>专注眼前的体验</span><span>COMING INTO FOCUS</span></div></a>
  </section>
  <section id="faq" class="faq-section wrap section-pad"><div><span class="section-number">05 / 你可能想问</span><h2>说得再<br/>具体一点。</h2></div><div class="faq-list">{faqs.map((f,i)=><details open={i===0}><summary>{f.q}<span class="disclosure" aria-hidden="true"></span></summary><p>{f.a}</p></details>)}</div></section>
  <div class="wordmark-end wrap" aria-hidden="true">auradio</div>
</Site>

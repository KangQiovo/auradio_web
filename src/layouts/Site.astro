---
import '../styles/global.css';
import '../styles/albums.css';
import { route, repo } from '../lib/urls';
import Arrow from '../components/Arrow.astro';
interface Props { title?: string; description?: string; active?: string; light?: boolean }
const { title = 'Auradio — 听见，也看见', description = 'Auradio 是仍在打磨中的 Android 音乐播放器。了解本地曲库、三种界面主题、当前预发布进度，进入独立的网页声音体验。', active = 'home', light = false } = Astro.props;
const links = [{id:'home',label:'概览',href:route()},{id:'experience',label:'体验',href:route('experience/')},{id:'progress',label:'关于进展',href:route('progress/')},{id:'privacy',label:'使用与隐私',href:route('privacy/')}];
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="theme-color" content="#101d24"/><meta name="color-scheme" content="dark light"/>
    <meta name="description" content={description}/><meta name="referrer" content="strict-origin-when-cross-origin"/>
    <title>{title}</title><link rel="canonical" href={canonical}/>
    <link rel="icon" type="image/svg+xml" href={route('brand/auradio.svg')}/>
    <meta property="og:type" content="website"/><meta property="og:locale" content="zh_CN"/>
    <meta property="og:site_name" content="Auradio"/><meta property="og:title" content={title}/>
    <meta property="og:description" content={description}/><meta property="og:url" content={canonical}/>
    <meta property="og:image" content={new URL(route('brand/social.svg'), Astro.site)}/>
    <script is:inline>try{if(localStorage.getItem('auradio.motion')==='reduce')document.documentElement.dataset.motion='reduce'}catch{}</script>
  </head>
  <body class:list={[{ 'page-light': light }]}>
    <a class="skip-link" href="#main">跳至正文</a>
    <header class="site-header">
      <div class="nav-shell">
        <a class="brand" href={route()} aria-label="Auradio 首页"><img src={route('brand/auradio.svg')} width="46" height="46" alt=""/><span>auradio</span></a>
        <nav class="desktop-nav" aria-label="主导航">{links.map(l => <a href={l.href} aria-current={active === l.id ? 'page' : undefined}>{l.label}</a>)}</nav>
        <a class="nav-action" href={route('experience/')}>走进声音 <Arrow diagonal/></a>
        <button class="menu-button" aria-label="打开导航" aria-expanded="false" aria-controls="mobile-nav"><span></span><span></span></button>
      </div>
      <nav id="mobile-nav" class="mobile-nav" aria-label="移动导航" hidden>{links.map(l => <a href={l.href} aria-current={active === l.id ? 'page' : undefined}>{l.label}<Arrow/></a>)}<a href={route('credits/')}>技术鸣谢 <Arrow/></a></nav>
      <div class="reading-progress" aria-hidden="true"></div>
    </header>
    <main id="main"><slot/></main>
    <footer class="site-footer">
      <div class="footer-main wrap">
        <div><a class="brand footer-brand" href={route()}><img src={route('brand/auradio.svg')} width="46" height="46" alt=""/><span>auradio</span></a><p>音乐在前，界面在后。</p></div>
        <div class="footer-links"><a href={route('progress/')}>关于进展</a><a href={route('privacy/')}>使用与隐私</a><a href={route('credits/')}>技术鸣谢</a><a href={`${repo}/issues`} target="_blank" rel="noopener noreferrer">反馈官网问题 <Arrow diagonal/></a></div>
        <div class="footer-note"><p>ANDROID · IN DEVELOPMENT</p><span>当前为预发布阶段<br/>不提供公开安装包下载</span></div>
      </div>
      <div class="footer-bottom wrap"><span>© 2026 KangQi · Auradio</span><button type="button" data-motion-toggle aria-pressed="false">减少动态<span class="toggle-track" aria-hidden="true"></span></button><a href={repo} target="_blank" rel="noopener noreferrer">官网源代码 <Arrow diagonal/></a></div>
    </footer>
    <noscript><style>.menu-button{display:none!important}.desktop-nav{display:flex!important;flex-wrap:wrap;gap:14px;font-size:12px}.nav-action{display:none!important}</style><div class="no-script">当前未启用 JavaScript。介绍与进度仍可阅读；音频试听和交互效果需要启用 JavaScript。</div></noscript>
    <script>import '../scripts/site';</script>
  </body>
</html>
